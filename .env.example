# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only (webhooks, cron, admin actions). Never expose to the client.
SUPABASE_SECRET_KEY=

# Base URL for links in auth emails. Set it in production; leave empty in dev
# to use the request's own host.
NEXT_PUBLIC_SITE_URL=
# Contact address for questions and data export/deletion requests; must match
# the Datenschutzerklärung.
NEXT_PUBLIC_CONTACT_EMAIL=
# Cloudflare Turnstile. Leave empty in dev to skip the CAPTCHA (it must also be off in Supabase Auth).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Stripe (test keys in dev). Price ids for the two founding plans.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FOUNDING_MONTHLY=
STRIPE_PRICE_FOUNDING_ANNUAL=

# Fourthwall (Settings → For Developers). The Open API user creates the member
# merch codes; the storefront token lists products on /app/shop.
FOURTHWALL_API_USERNAME=
FOURTHWALL_API_PASSWORD=
FOURTHWALL_STOREFRONT_TOKEN=
# Shop base URL, e.g. https://shop.thatsgamedev.com (product links: /products/{slug}).
FOURTHWALL_SHOP_URL=
# Optional: collection slug for /app/shop (default: all).
FOURTHWALL_COLLECTION=

# Vercel sends it as "Authorization: Bearer …" to /api/cron/*. Any long random string.
CRON_SECRET=
